[Unit]
Description=Magic Rust — ответы на команды в Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=magicrust
WorkingDirectory=/opt/magicrust-bot
EnvironmentFile=-/opt/magicrust-bot/.env
ExecStart=/opt/magicrust-bot/venv/bin/python /opt/magicrust-bot/bot.py telegram
Restart=always
RestartSec=15

# NoNewPrivileges здесь намеренно не выставлен: этот флаг запрещает процессу
# повышать права, а sudo — setuid-программа, и команды /restart и /update
# перестают работать с ошибкой «no new privileges flag is set».
# Если эти команды не нужны, верните NoNewPrivileges=true — остальное работает.
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/magicrust-bot/state

[Install]
WantedBy=multi-user.target
