[Unit]
Description=Проверять кейс Magic Rust каждые 20 минут

[Timer]
# Календарное расписание, а не OnBootSec= + OnUnitActiveSec=. Монотонные таймеры
# отсчитываются от загрузки и от последнего запуска сервиса, и на давно поднятой
# машине после перезапуска юнита им не от чего считать: таймер уходит в состояние
# "active (elapsed)" с Trigger: n/a и больше не срабатывает никогда.
OnCalendar=*:0/20
# Разброс, чтобы запросы не шли секунда в секунду.
RandomizedDelaySec=240
# Догнать пропущенный запуск, если VPS был выключен (работает только с OnCalendar).
Persistent=true
Unit=magicrust-case.service

[Install]
WantedBy=timers.target
