# Скопируйте в .env и заполните при необходимости.

# Уведомления в Telegram (необязательно).
# TG_TOKEN берётся у @BotFather, TG_CHAT_ID — у @userinfobot.
TG_TOKEN=
TG_CHAT_ID=
# 0 — показывать окно браузера (отладка/вход), 1 — headless (для VPS).
HEADLESS=1

# Режим игры, в котором открывать кейс: modded или vanillax2plus.
# Серебро начисляется в выбранном режиме — ставьте тот, где играете.
MR_GMOD=modded

# Часовой пояс браузера.
MR_TZ=Europe/Moscow

# Переопределить User-Agent (обычно не нужно).
# MR_UA=
